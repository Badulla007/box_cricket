# Required before public deployment: generate a long random value.
SECRET_KEY=replace-with-a-long-random-secret

# Local database. Existing instance/boundary.db is preserved by the app.
DATABASE_URL=sqlite:///boundary.db
APP_TIMEZONE=Asia/Kolkata
FLASK_DEBUG=true

# Gmail SMTP: use a Google App Password, not your regular Gmail password.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=yourgmail@gmail.com
MAIL_PASSWORD=your_google_app_password_without_spaces
MAIL_DEFAULT_SENDER=yourgmail@gmail.com
MAIL_TIMEOUT=20

# In local development only, when SMTP fails, OTP is printed to Flask terminal.
# Set false on production. The application never claims console output is an email.
CONSOLE_OTP_FALLBACK=true

OTP_TTL_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
SESSION_COOKIE_SECURE=false

# Optional real-world discovery. OpenStreetMap Nominatim is used without an API key.
NOMINATIM_USER_AGENT=BOUNDARYBoxCricket/1.0 (your-contact-email@example.com)

# Admin account is seeded only if it does not already exist.
BOUNDARY_ADMIN_PASSWORD=Boundary@123
ALLOW_DEMO_DATA=true
